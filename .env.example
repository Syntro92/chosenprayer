# Copy to .env and fill in. Real values never go in git (.env is ignored).
# Server-only unless the name starts with NEXT_PUBLIC_.

# Supabase project
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # secret: bypasses RLS. Server only.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # public by design; RLS limits what it can do

# Postgres (Supabase Dashboard > Connect). The direct host is IPv6-only, so use the poolers.
DB_PASSWORD=
DATABASE_URL=                         # session pooler :5432, used by migrations
DATABASE_URL_POOLER=                  # transaction pooler :6543, used by the running app

# App
APP_URL=http://localhost:3000
CRON_SECRET=                          # random 32+ chars; protects /api/cron/*

# Providers (mock/console until the real accounts exist)
PAYMENTS_PROVIDER=mock                # mock | stripe
EMAIL_PROVIDER=console                # console | resend | mailtrap
# Stripe sandbox (test mode). Dashboard > Developers > API keys, with the "Test mode" / sandbox switch ON.
# Live keys (sk_live_/pk_live_) are refused outside production.
STRIPE_SECRET_KEY=                    # sk_test_...  (server only, never commit)
STRIPE_PUBLISHABLE_KEY=               # pk_test_...  (public; shown to browsers for the card form)
STRIPE_WEBHOOK_SECRET=                # whsec_...  from `stripe listen` (local) or the webhook endpoint (deployed)
RESEND_API_KEY=
MAILTRAP_API_TOKEN=                   # Mailtrap > Settings > API Tokens (Email Sending, chosenprayer.com)
EMAIL_FROM=                           # e.g. no-reply@chosenprayer.com (verified domain)
EMAIL_FROM_NAME=Chosen Prayer

# YouTube Data API v3 key: lets the admin link a channel by its YouTube ID (subscribers + recent videos).
YOUTUBE_API_KEY=
